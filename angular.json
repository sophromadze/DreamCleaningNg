{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "DreamCleaningNG": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/dream-cleaning-ng",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "/assets"
              }
            ],
            "styles": [
              "src/styles.scss",
              "node_modules/leaflet/dist/leaflet.css",
              {
                "input": "node_modules/@fortawesome/fontawesome-free/css/all.min.css",
                "bundleName": "fontawesome",
                "inject": false
              }
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["src/styles"]
            },
            "scripts": [],
            "allowedCommonJsDependencies": [
              "leaflet",
              "xlsx"
            ],
            "server": "src/main.server.ts",
            "prerender": false,
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2MB",
                  "maximumError": "3MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "200kB",
                  "maximumError": "300kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            },
            "test": {
              "aot": false,
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "polyfills": [
                "zone.js",
                "zone.js/testing",
                "zone.js/plugins/vitest-patch"
              ],
              "inlineStyleLanguage": "scss",
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                }
              ],
              "styles": [
                "src/styles.scss"
              ],
              "scripts": []
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "DreamCleaningNG:build:production"
            },
            "development": {
              "buildTarget": "DreamCleaningNG:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "::test",
            "tsConfig": "tsconfig.spec.json",
            "runnerConfig": "vitest-base.config.mts",
            "setupFiles": [
              "src/testing/vitest-setup.ts"
            ],
            "exclude": [
              "app/shared/components/recurring-series-panel/recurring-series-panel.component.spec.ts",
              "app/contract/contract-sign/contract-sign.component.spec.ts"
            ]
          },
          "configurations": {
            "browser": {
              "include": [
                "app/shared/components/recurring-series-panel/recurring-series-panel.component.spec.ts",
                "app/contract/contract-sign/contract-sign.component.spec.ts"
              ],
              "exclude": [],
              "runnerConfig": "vitest-browser.config.mts",
              "browsers": [
                "chromiumHeadless"
              ]
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "991239cc-b388-4fc2-990f-ef455b806568"
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}