{
  "name": "dream-cleaning-ng",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration development",
    "start:prod": "ng serve --configuration production",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "build:ssr": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false && ng test --configuration browser --watch=false",
    "test:watch": "ng test --watch",
    "test:coverage": "ng test --watch=false --coverage && ng test --configuration browser --watch=false --coverage",
    "serve:ssr:DreamCleaningNG": "node dist/dream-cleaning-ng/server/server.mjs",
    "images:responsive": "node scripts/responsive-images.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "private": true,
  "dependencies": {
    "@abacritt/angularx-social-login": "^2.6.0",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-server": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@angular/ssr": "^22.2.2",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@microsoft/signalr": "^10.0.11",
    "@stripe/stripe-js": "^10.0.0",
    "chart.js": "^4.5.1",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "marked": "^18.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.14",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.1",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
